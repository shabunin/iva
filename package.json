{
  "name": "iva",
  "version": "0.0.1",
  "description": "iva - iViewer assistant: JSX compiler, CLI and live preview for CommandFusion iViewer (.gui) projects",
  "private": true,
  "type": "module",
  "bin": {
    "iva": "./bin/iva.mjs"
  },
  "scripts": {
    "dev": "node bin/iva.mjs dev",
    "fixtures": "git clone --depth 1 https://github.com/CommandFusion/DemoUserInterfaces fixtures/DemoUserInterfaces",
    "lint": "node scripts/lint.mjs",
    "test": "node --test --import tsx test/*.test.ts",
    "tauri": "tauri",
    "panel:dev": "vite --config panel/vite.config.ts",
    "panel:build": "vite build --config panel/vite.config.ts",
    "panel:android": "cd panel && tauri android build --apk"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@matter/general": "0.17.7",
    "@matter/main": "0.17.7",
    "@matter/protocol": "0.17.7",
    "@matter/types": "0.17.7",
    "@pixi/ui": "^2.3.2",
    "@project-chip/matter.js": "0.17.7",
    "@resvg/resvg-js": "^2.6.2",
    "@xmldom/xmldom": "^0.9.12",
    "chart.js": "4.5.1",
    "esbuild": "^0.28.2",
    "motion": "^12.23.24",
    "pixi.js": "^8.18.1",
    "qrcode": "^1.5.4",
    "three": "0.186.1",
    "tsx": "^4.21.0",
    "uplot": "1.6.32",
    "vite": "^6.2.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.3",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-websocket": "^2.5.0",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.5.12",
    "linkedom": "^0.18.13",
    "typescript": "~5.8.2"
  }
}
