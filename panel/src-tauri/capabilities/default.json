{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The panel page: GUIs and their requests from anywhere (the HTTP client), WebSockets",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*:*" },
        { "url": "https://*:*" }
      ]
    },
    "websocket:default"
  ]
}
