<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12's splash icon: the system draws an icon that isn't an adaptive one in a box 60% of 288 dp (172.8 dp: 518 px
     on a Nexus 5) - the app's icon inset 15.3% a side of it, 120 dp, as the window's background (splash.xml) and the
     loading screen have it (a fraction: whatever the box) -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/app_icon"
    android:inset="15.3%" />
