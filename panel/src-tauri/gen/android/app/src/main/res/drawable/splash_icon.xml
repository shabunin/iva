<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12's splash icon: the system draws an icon that isn't an adaptive one in a box 60% of 288 dp (172.8 dp: 518 px
     on a Nexus 5), masked to a circle - the app's icon inset 26.4 dp a side of it, 120 dp (in the circle, corners and
     all), as the window's background (splash.xml) and the loading screen have it. (A fraction inset isn't taken.) -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/app_icon"
    android:inset="26.4dp" />
