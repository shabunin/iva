{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "iva panel",
  "version": "0.1.0",
  "identifier": "tech.bobalus.iva.panel",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5190",
    "beforeDevCommand": "npm run panel:dev",
    "beforeBuildCommand": "npm run panel:build"
  },
  "app": {
    "windows": [
      {
        "title": "iva panel",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
